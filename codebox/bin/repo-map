#!/usr/bin/env bash
# repo-map <service>: files and function signatures for one service.
set -euo pipefail
arg=${1:?usage: repo-map <service>}
. "$(dirname "$0")/_index"
if has_index; then
  out=$(query symbols.tsv '$3 == ENVIRON["ARG"] { print $1 ":" $2 " " $4 " " $6 }')
  echo "${out:-no symbols indexed for $arg}"
  exit 0
fi
echo "(no code index; ctags)"
ctags -R -x --sort=no --fields=+S "src/$arg" 2>/dev/null \
  | awk '$2 ~ /function|method|class|struct|interface|func/ {print $4":"$3" "$2" "$1}' | head -200
