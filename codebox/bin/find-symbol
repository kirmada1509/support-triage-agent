#!/usr/bin/env bash
# find-symbol <name>: where a function or type is defined, and where it's used.
set -euo pipefail
arg=${1:?usage: find-symbol <name>}
. "$(dirname "$0")/_index"
echo "definitions:"
if has_index; then
  query symbols.tsv '$5 == ENVIRON["ARG"] { print $1 ":" $2 " " $3 " " $4 " " $6 }'
else
  ctags -R -x src/ 2>/dev/null | awk -v n="$arg" '$1 == n {print $4":"$3" "$2}'
fi
echo "references:"
rg -n -w --fixed-strings --max-count 20 -- "$arg" src/ | head -40 || true
