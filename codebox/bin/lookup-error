#!/usr/bin/env bash
# lookup-error "<text>": where an error or log message is produced, with file and line. The text
# can be part of the message in the code, or a whole message the code produced (a customer's quote).
set -euo pipefail
arg=${1:?usage: lookup-error "<text>"}
. "$(dirname "$0")/_index"
if has_index; then
  out=$(query errors.tsv 'BEGIN { t = tolower(ENVIRON["ARG"]) }
    index(tolower($4), t) || ($5 != "" && ENVIRON["ARG"] ~ $5) { print $1 ":" $2 " " $3 ": " $4 }')
  if [ -n "$out" ]; then echo "$out"; exit 0; fi
  echo "(not in the error index; plain search)"
else
  echo "(no code index; plain search)"
fi
rg -n --fixed-strings --ignore-case --max-count 5 -- "$arg" src/ || echo "not found: $arg"
