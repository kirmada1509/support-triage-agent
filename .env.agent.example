# Copy to .env.agent and fill in. Never commit .env.agent.
DATABASE_URL=postgresql://triage:triage@localhost:5433/triage
PYLON_WEBHOOK_SECRET=dev-secret
API_BASE_URL=http://localhost:8000

# LLM providers: only the ones your profile uses (make models lists what's missing)
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Categorization
TYPESAFE_API_KEY=

# Optional engineering handoff; without it, findings stay local and appear in the final outcome.
LINEAR_API_KEY=
# Optional team key for feature requests (e.g. ROAD); service team keys are in ownership.yaml.
ROADMAP_LINEAR_TEAM=
# Optional evidence links in Linear issue descriptions.
GITHUB_REPO_URL=
JAEGER_BASE_URL=http://localhost:8080
GRAFANA_PANEL_URL=

# Customer delivery. Set both token and a Pylon issue ID in the webhook payload for live replies.
# Use https://api.eu.usepylon.com for an EU Pylon workspace.
PYLON_API_TOKEN=
PYLON_API_BASE_URL=https://api.usepylon.com

# Sandbox (your fork of opentelemetry-demo)
SANDBOX_DIR=../opentelemetry-demo

# HolmesGPT's `history` toolset: choose a random password before `make migrate`.
# `make migrate` creates this login with SELECT on deploys and flag_changes only.
HISTORY_DB_URL=postgresql://history_ro:REPLACE_WITH_RANDOM_PASSWORD@localhost:5433/triage
# Optional: send the agent's own traces to the shop's collector (see app/tracing.py).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:8080/otlp-http   (the shop collector, via its proxy;
#   inside the shop network: http://otel-collector:4318)
# Models (config/roles.yaml): deepseek (default), gemini, openai or openrouter; single roles
#   can be moved to any model in config/models.yaml.
# ROLE_PROFILE=openai
# ROLE_MODELS=data_analyst=gpt-5.4-mini,codebase_analyst=gpt-5.4-mini
