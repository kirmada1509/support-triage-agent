# Copy to .env.agent and fill in. Never commit .env.agent.
DATABASE_URL=postgresql://triage:triage@localhost:5433/triage
PYLON_WEBHOOK_SECRET=dev-secret
API_BASE_URL=http://localhost:8000

# LLM providers: only the ones your profile uses (make models lists what's missing)
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Categorization
TYPESAFE_API_KEY=

# Engineering handoff
LINEAR_API_KEY=

# Sandbox (your fork of opentelemetry-demo)
SANDBOX_DIR=../opentelemetry-demo

# HolmesGPT's `history` toolset reads deploys and flag changes from the agent's DB (read-only).
HISTORY_DB_URL=postgresql://triage:triage@db:5432/triage
# Optional: send the agent's own traces to the shop's collector (see app/tracing.py).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:8080/otlp-http   (the shop collector, via its proxy;
#   inside the shop network: http://otel-collector:4318)
# Models (config/roles.yaml): deepseek (default), gemini, openai or openrouter; single roles
#   can be moved to any model in config/models.yaml.
# ROLE_PROFILE=openai
# ROLE_MODELS=data_analyst=gpt-5.4-mini,codebase_analyst=gpt-5.4-mini
