From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maya Patel <maya.patel@example.com>
Date: Thu, 24 Sep 2026 13:10:00 +0000
Subject: [PATCH 7/8] chore(payment): give declined-charge logs a message

---
 src/payment/index.js | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/payment/index.js b/src/payment/index.js
index 960d4c49..cb0b67a5 100644
--- a/src/payment/index.js
+++ b/src/payment/index.js
@@ -23,7 +23,7 @@ async function chargeServiceHandler(call, callback) {
     callback(null, response)
 
   } catch (err) {
-    logger.warn({ err })
+    logger.warn({ err }, 'Charge declined.')
 
     span?.setStatus({ code: opentelemetry.SpanStatusCode.ERROR, message: err.message })
     span?.setAttribute(ATTR_ERROR_TYPE, err.name || 'Error')
