# DO NOT PUSH CHANGES OF THIS FILE TO opentelemetry/opentelemetry-demo
# PLACE YOUR .env ENVIRONMENT VARIABLES OVERRIDES IN THIS FILE

# Rootless podman: use the podman Docker-compatible API socket so the collector's
# docker resource detector and docker_stats receiver can connect.
# DOCKER_SOCK=/run/user/1000/podman/podman.sock

# To use a real OpenAI API-compatible LLM,
# set the appropriate values for the target LLM
# Required permissions:
# [Models and Model capabilities]

#LLM_BASE_URL=https://api.openai.com/v1
#LLM_MODEL=gpt-4o-mini
#OPENAI_API_KEY=<replace with API key>

# Support triage sandbox.
# Every service that isn't versioned runs the 3.1.0 release images (upstream's .env says
# `latest`, which moves), and reports 3.1.0 as its service.version.
DEMO_VERSION=3.1.0
IMAGE_VERSION=3.1.0
# .env resolves this from its own IMAGE_VERSION before this file is read, so restate it.
OTEL_RESOURCE_ATTRIBUTES=service.namespace=${OTEL_SERVICE_NAMESPACE},service.version=${IMAGE_VERSION}
# Trace retention, see compose.extras.yaml.
# SANDBOX_JAEGER_MAX_TRACES=25000
# SANDBOX_JAEGER_MEMORY=1200M
# SANDBOX_LOCUST_USERS=2
